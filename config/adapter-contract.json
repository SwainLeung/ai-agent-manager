{
  "schema_version": 1,
  "name": "local-agent-adapter",
  "purpose": "Provider-neutral bridge from a host Agent into routing, graph execution, trace recording, and reversible feedback.",
  "operations": {
    "prepare": {
      "input": {"task": "string", "signals": "optional RouteSignals", "top_k": "integer >= 1"},
      "output": {"task": "string", "decisions": "RouteDecision[]", "active_rules": "approved and enabled rules, exposed as host metadata"}
    },
    "run": {
      "input": {"task": "string", "inputs": "object", "graph": "optional path", "retry": "optional RetryPolicy"},
      "output": {"context": "ExecutionContext", "trace": "path", "checkpoint": "path"}
    },
    "host_run": {
      "input": {"task": "string", "inputs": "object", "checkpoint": "optional path", "correction": "optional reversible FeedbackEvent"},
      "output": {"run": "AdapterRun", "feedback": "optional FeedbackEvent", "provider_calls": "none"}
    },
    "provider_complete": {
      "input": {"prompt": "string", "metadata": "optional object"},
      "output": {"response": "ProviderResponse", "credentials_owned_by": "host"}
    },
    "tool_invoke": {
      "input": {"tool": "string", "arguments": "object", "dry_run": "boolean, default true", "effect_gate": "optional EffectGate"},
      "output": {"result": "ToolResult", "external_effect_default": "false"}
    },
    "decide": {
      "input": {"entity_file": "JSON object, entity array, or object with entities[]"},
      "output": {"proposals": "ExecutionProposal[]", "counts": "script|skill|human_review", "human_gate_required": "boolean"}
    },
    "execute": {
      "input": {"entity_file": "JSON object, entity array, or manifest object with entities[] and optional entity_count", "checkpoint": "optional path", "max_items": "optional integer", "checkpoint_every": "integer >= 1, default 100"},
      "output": {"status": "completed|paused", "status_counts": "completed|pending|failed", "kind_counts": "script|skill|human_review", "entity_fingerprint": "SHA-256 of ordered input entities", "checkpoint": "path"}
    },
    "solidify": {
      "input": {"skill_id": "existing Skill id", "records": "execution record array or checkpoint object", "operation": "deterministic operation", "min_successes": "integer >= 1", "min_success_rate": "0..1"},
      "output": {"eligible": "boolean", "candidate": "optional Script descriptor", "registry_mutated": "false", "review_required": "true"}
    },
    "sandbox": {
      "input": {"candidate_file": "candidate Script descriptor or solidify report", "entity_file": "fixture entity array or manifest", "drift_tolerance": "0..1"},
      "output": {"status": "passed|failed", "cases": "deterministic replay records", "registry_mutated": "false", "external_effects": "false", "provider_calls": "0"}
    },
    "audit_files": {
      "input": {"root": "local directory", "output_dir": "report directory", "stale_days": "number >= 0, default 2"},
      "output": {"manifest": "flowus-local-manifest.json", "report": "flowus-anti-entropy-report.json", "merge_candidates": "flowus-merge-candidates.json", "delete_candidates": "flowus-delete-candidates.json", "mutation_performed": "false"}
    },
    "promote": {
      "input": {"checkpoint": "execution checkpoint", "min_successes": "integer >= 1", "min_success_rate": "0..1"},
      "output": {"candidates": "PromotionCandidate[]", "registry_mutated": "false"},
      "review": {"decision": "approve|reject", "note": "string", "registry_mutated": "false"}
      ,"plan": {"operation": "approved operation", "registry_file": "path", "manifest_file": "path", "output": "RegistryPatch", "registry_mutated": "false"}
      ,"approve": {"manifest_file": "path", "note": "string", "registry_mutated": "false"}
      ,"apply": {"operation": "approved operation or manifest_file", "registry_file": "path", "manifest_file": "optional path", "write": "boolean", "output": "RegistryPatch", "default_write": false, "requires_approved_manifest_when_manifest_is_used": true}
      ,"rollback": {"manifest_file": "path", "registry_file": "path", "write": "boolean", "output": "RegistryPatch", "default_write": false, "checks_current_hash": true}
    },
    "feedback": {
      "input": {"event_type": "undo|redo|pitfall|fallback|correction|approval", "scope": "profile|project", "subject": "string", "note": "string", "confidence": "0..1"},
      "output": {"status": "candidate", "storage": "ignored runtime state"}
    },
    "rules": {
      "input": {"operation": "sync|list|review|revoke", "rule_id": "required for review/revoke", "decision": "approve|reject", "note": "required for review/revoke"},
      "output": {"active_rules": "approved and enabled rules exposed to AdapterPlan", "registry_mutated": "false", "storage": "ignored runtime state"}
    },
    "report": {
      "input": {},
      "output": {"feedback_candidates": "array", "lifecycle_proposals": "array", "entropy_findings": "array", "metrics": "runtime usage and status metrics", "metacognition": "hypotheses and reversible rule candidates", "rules": "reviewed rule store report"}
    }
  },
  "events": [
    "run_started",
    "run_resumed",
    "node_started",
    "node_finished",
    "node_failed",
    "checkpoint_saved",
    "run_finished"
  ],
  "state_boundary": {
    "default_directory": ".agent-manager/",
    "git_tracked": false,
    "public_files_must_not_contain": ["credentials", "private prompts", "user data", "production logs"]
  },
  "host_responsibilities": [
    "model/provider calls",
    "tool authentication",
    "human approval",
    "provider-specific handlers",
    "promotion of feedback candidates"
  ]
}
